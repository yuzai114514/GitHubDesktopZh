<ui:FluentWindow x:Class="GitHubDesktopZh.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:GitHubDesktopZh.App"
        mc:Ignorable="d"
        Title="GitHub Desktop 中文助手" Height="620" Width="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="GitHub Desktop 中文助手" ShowMaximize="False"/>

        <!-- 可滚动内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 状态指示 -->
                <ui:CardExpander IsExpanded="False" Margin="0,12,0,12">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel Margin="8,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="版本：" Opacity="0.7" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DesktopVersion}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="架构：" Opacity="0.7" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ArchitectureText}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="模式：" Opacity="0.7" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ResourceLayoutText}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="路径：" Opacity="0.7" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InstallationPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallationPath}"/>
                        </Grid>

                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                                Visibility="{Binding LogText, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="运行日志" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,4"/>
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding LogText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:CardExpander>

                <!-- 汉化状态 + 可用补丁 -->
                <ui:Card Margin="0,0,0,12" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="汉化状态" FontSize="14" FontWeight="SemiBold"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="Green" Margin="0,0,6,0" Visibility="{Binding LocalizedVersion, Converter={StaticResource StringToVisibilityConverter}}"/>
                                <TextBlock VerticalAlignment="Center" Text="{Binding LocalizedVersion, StringFormat='已汉化 {0}'}" Visibility="{Binding LocalizedVersion, Converter={StaticResource StringToVisibilityConverter}}"/>
                                <TextBlock Text="未汉化" Opacity="0.5" VerticalAlignment="Center" Visibility="{Binding LocalizedVersion, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                                Visibility="{Binding AvailablePatchInfo, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="可用补丁" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding AvailablePatchInfo}" TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- 进度条 + 当前步骤 -->
                <StackPanel Margin="0,0,0,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="0,0,0,4">
                        <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4"/>
                        <TextBlock Text="{Binding ProgressText}" FontSize="10" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    </Grid>
                    <TextBlock Text="{Binding CurrentStep}" FontSize="12" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <ui:Card Margin="0,0,0,12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="操作" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ui:Button Grid.Row="0" Grid.Column="0" Content="一键汉化" Command="{Binding LocalizeCommand}" 
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" Height="36"/>
                            <ui:Button Grid.Row="0" Grid.Column="2" Content="检查更新" Command="{Binding CheckForUpdatesCommand}" 
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" Height="36"/>
                            <ui:Button Grid.Row="2" Grid.Column="0" Content="恢复官方" Command="{Binding RestoreCommand}" 
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" Height="36"/>
                            <ui:Button Grid.Row="2" Grid.Column="2" Content="检查本软件更新" Command="{Binding CheckAppUpdatesCommand}" 
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}" Height="36"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 快捷设置 -->
                <ui:Card Margin="0,0,0,12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="快捷设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <CheckBox Content="自动检查" IsChecked="{Binding AutoCheck}" Margin="0,0,16,8"/>
                            <CheckBox Content="自动汉化" IsChecked="{Binding AutoLocalize}" Margin="0,0,16,8"/>
                            <CheckBox Content="开机启动" IsChecked="{Binding StartWithWindows}" Margin="0,0,16,8"/>
                            <CheckBox Content="静默启动" IsChecked="{Binding SilentStartup}" IsEnabled="{Binding StartWithWindows}"/>
                        </WrapPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 详细设置 -->
                <ui:CardExpander Header="详细设置" IsExpanded="False" Margin="0,0,0,12">
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="索引 URL（每行一个，按顺序尝试）" Opacity="0.7" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding IndexUrl, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" MinHeight="120" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="检查间隔（分钟）" Opacity="0.7" Margin="0,12,0,6"/>
                        <TextBox Text="{Binding CheckIntervalMinutes}" HorizontalContentAlignment="Right" MinWidth="60"/>

                        <TextBlock Text="保留备份数量" Opacity="0.7" Margin="0,12,0,6"/>
                        <TextBox Text="{Binding BackupCount}" HorizontalContentAlignment="Right" MinWidth="60"/>
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部信息 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Opacity="0.5" FontSize="11">
                <Run Text="最后检查: "/>
                <Run Text="{Binding LastCheckTime, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Opacity="0.5" FontSize="11" Margin="16,0,0,0">
                <Run Text="最后操作: "/>
                <Run Text="{Binding LastOperationTime, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
